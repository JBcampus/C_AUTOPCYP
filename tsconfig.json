{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["cypress", "node"]
  },
  "include": ["playground/**/*.ts", "cypress/**/*.ts"],
  "exclude": ["node_modules", "artifacts"]
}
