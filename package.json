{
  "name": "cypress-e2e",
  "version": "1.0.0",
  "description": "Proyecto de automatización E2E con Cypress y TypeScript",
  "type": "module",
  "scripts": {
    "dev": "tsx playground/clase1/taller1.ts",
    "typecheck": "tsc --noEmit",
    "cy:open": "cypress open",
    "cy:open:e2e": "cypress open --e2e",
    "cy:open:chrome": "cypress open --e2e --browser chrome",
    "cy:open:edge": "cypress open --e2e --browser edge",
    "cy:open:electron": "cypress open --e2e --browser electron",
    "cy:run": "cypress run --e2e",
    "cy:run:chrome": "cypress run --e2e --browser chrome",
    "cy:run:edge": "cypress run --e2e --browser edge",
    "cy:run:headed": "npm run cy:run:edge -- --headed",
    "cy:run:taller2": "npm run cy:run:headed -- --spec 'cypress/e2e/clase2/taller2.cy.ts'",
    "cy:run:taller2:debug": "npm run cy:run:taller2 -- --no-exit",
    "cy:run:tarea1": "npm run cy:run:headed -- --spec 'cypress/e2e/tarea1/tarea1.cy.ts'",
    "cy:run:taller3:debug": "npm run cy:run:headed -- --spec 'cypress/e2e/clase3/input-class.cy.ts' --no-exit"
  },
  "keywords": [],
  "author": "Adelina B.",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^26.5.1",
    "cypress": "^16.1.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
